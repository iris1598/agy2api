# ================================================================
# AGY2API 环境变量配置示例文件
# 复制此文件为 .env 并根据需要修改配置值
# ================================================================

# ================================================================
# 服务器配置
# ================================================================

# 服务器监听地址
# 默认: 0.0.0.0 (监听所有网络接口)
HOST=0.0.0.0

# 服务器端口
# 默认: 7861
PORT=7861

# ================================================================
# 密码配置 (分离密码)
# ================================================================

# 聊天API访问密码 (用于OpenAI/Gemini/Claude API端点认证)
# 默认: pwd
API_PASSWORD=your_api_password

# 控制面板访问密码 (用于Web界面登录认证)
# 默认: pwd
PANEL_PASSWORD=your_panel_password

# IP 白名单 (可选)
# 启用开关 + 逗号或换行分隔的白名单列表
# 每条支持: 单个IP / CIDR网段 / 起止范围(- 或 ~ 分隔), IPv4/IPv6 均可
# 开启后仅白名单内 IP 可访问面板和 API, 其余 IP 直接 403
# 默认: 关闭 (不限制)
IP_WHITELIST_ENABLED=false
IP_WHITELIST=

# 模型名复写 (可选)
# 启用后按规则匹配请求模型名(支持正则), 命中则替换为指定模型名
# 规则格式: JSON 数组 [匹配正则, 替换模型名] 的数组; 也支持 "正则->替换名" 逗号分隔
# 替换名支持正则反向引用 (如 \1)
# 默认: 关闭
MODEL_REWRITE_ENABLED=false
MODEL_REWRITE_RULES=[["^gpt-4$","gemini-2.5-pro"],["^claude-3-5-sonnet.*$","claude-sonnet-4-5"]]

# ================================================================
# 存储配置
# ================================================================

# 存储后端优先级: PostgreSQL > 本地sqlite文件存储
# 系统会自动选择可用的最高优先级存储后端

# PostgreSQL 分布式存储模式配置 (最高优先级)
# 设置 POSTGRESQL_URI 后自动启用 PostgreSQL 模式
# 格式: postgresql://user:password@localhost:5432/agy2api
# 默认: 无 (不启用 PostgreSQL 存储，使用本地SQLite)
POSTGRESQL_URI=

# ================================================================
# Google API 配置
# ================================================================

# 凭证文件目录 (仅在文件存储模式下使用)
# 默认: ./creds
CREDENTIALS_DIR=./creds

# 代理配置 (可选)
# 支持 http, https, socks5 代理
# 格式: http://proxy:port, https://proxy:port, socks5://proxy:port
PROXY=http://localhost:7890

# Google API 代理 URL 配置 (可选)

# Google OAuth2 端点
# 默认: https://oauth2.googleapis.com
OAUTH_PROXY_URL=https://oauth2.googleapis.com

# 用于Google APIs调用的代理URL
# 默认: https://www.googleapis.com
GOOGLEAPIS_PROXY_URL=https://www.googleapis.com

# 用于Google Antigravity API的URL
# 默认: https://daily-cloudcode-pa.googleapis.com
ANTIGRAVITY_API_URL=https://daily-cloudcode-pa.googleapis.com

# ================================================================
# 错误处理和重试配置
# ================================================================

# 是否启用自动封禁功能
# 当凭证返回特定错误码时自动禁用该凭证
# 默认: false
AUTO_BAN=false

# 自动封禁的错误码列表 (逗号分隔)
# 默认: 403
AUTO_BAN_ERROR_CODES=403

# 是否启用 429 错误重试
# 默认: true
RETRY_429_ENABLED=true

# 429 错误最大重试次数
# 默认: 5
RETRY_429_MAX_RETRIES=5

# 429 错误重试间隔 (秒)
# 默认: 1
RETRY_429_INTERVAL=1

# ================================================================
# 并发与速率控制配置
# ================================================================

# 是否启用并发/速率控制
# 启用后对聊天 API（/v1、/v1beta）进行限流
# 超过限制的请求会返回 HTTP 429 错误，可通过控制面板热更新
# 默认: false
RATE_LIMIT_ENABLED=false

# 最大并发数（同一时刻最多处理多少个请求）
# 设为 0 表示不限制并发
# 保守建议: 5
# 默认: 5
RATE_LIMIT_MAX_CONCURRENT=5

# 时间窗口内最大请求数
# 保守建议: 20
# 默认: 20
RATE_LIMIT_REQUESTS_PER_WINDOW=20

# 限流时间窗口（秒）
# 默认: 60
RATE_LIMIT_WINDOW_SECONDS=60

# ================================================================
# 请求节流与抖动配置（单账号防封禁）
# ================================================================

# 是否启用请求节流（相邻请求最小间隔 + 随机抖动）
# 启用后每次向 Google 发送聊天请求前先等待，把请求节奏抹平滑，降低封禁风险
# 默认: false
REQUEST_THROTTLE_ENABLED=false

# 相邻两次请求之间的最小间隔（秒）
# 设为 0 表示只做随机抖动、不强制间隔
# 保守建议: 2.0
# 默认: 2.0
REQUEST_MIN_INTERVAL=2.0

# 每次请求额外附加的随机抖动上限（秒），实际值在 [0, 上限] 内随机
# 保守建议: 2.0
# 默认: 2.0
REQUEST_JITTER=2.0

# 串行模式（严格排队，不重叠发送）
# 开启后，下一个请求要等上一个请求【结束后】才开始（间隔从结束时刻起算）
# 适合 Antigravity CLI 等单账号/单会话场景
# 注意：需要同时开启 REQUEST_THROTTLE_ENABLED 才会生效
# 默认: false
REQUEST_SERIAL_ENABLED=false

# 上游流式响应读超时（秒）
# 相邻两次网络读取之间的最大空闲时长：上游流中途卡死（连接保持但不再发数据）
# 超过该时长即报错并释放请求，防止串行模式回合锁/限流并发名额被永久占用（死锁）
# 只要上游持续有数据到达就会不断重置计时，正常的超长生成不受影响
# 设为 0 可禁用（恢复无限等待，不建议）
# 默认: 300
STREAM_READ_TIMEOUT=300

# ================================================================
# 日志配置
# ================================================================

# 日志级别
# 可选值: debug, info, warning, error, critical
# 默认: info
LOG_LEVEL=info

# 完全静默：不打印任何日志到控制台输出
# 默认: 1（打印日志）
ENABLE_LOG=1

# ================================================================
# 高级功能配置
# ================================================================

# 抗截断最大尝试次数
# 用于 "抗截断-" 前缀的模型
# 默认: 3
ANTI_TRUNCATION_MAX_ATTEMPTS=3

# ================================================================
# 环境变量使用说明
# ================================================================

# 1. 存储模式配置 (按优先级自动选择):
#    - PostgreSQL 分布式模式 (最高优先级): 设置 POSTGRESQL_URI，数据存储在 PostgreSQL 数据库
#    - SQLite 本地模式 (默认): 不设置上述 URI，数据存储在本地 creds/credentials.db

# 2. 密码配置:
#    API_PASSWORD（聊天API）与 PANEL_PASSWORD（控制面板）独立设置，默认均为 pwd

# 3. 通用配置优先级:
#    环境变量 > 默认值

# 4. 布尔值环境变量:
#    true/1/yes/on 表示启用
#    false/0/no/off 表示禁用
